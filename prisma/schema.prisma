generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  tasks     Task[]
  customers Customer[]
  prescriptions Prescription[]
  orders Order[]
  appointments Appointment[]
  settings     WorkspaceSettings?
  branches     Branch[]
  products     Product[]
  expenses     Expense[]
  suppliers    Supplier[]
  purchases    PurchaseOrder[]
  ledgers      Ledger[]
  staffSchedules StaffSchedule[]
  reminders    CalendarReminder[]
  visits       Visit[]
}

model User {
  id          String   @id @default(cuid())
  fullName    String
  mobileNumber String? @unique
  email       String?  @unique
  password    String

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  tasks       Task[]

  role        Role     @default(STAFF)
  schedules   StaffSchedule[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branchId    String?
  branch      Branch? @relation(fields: [branchId], references: [id])

  isMobileVerified  Boolean             @default(false)
  mfaEnabled        Boolean             @default(false)
  mfaSecret         String?

  sessions          Session[]
  verificationCodes VerificationCode[]
  passwordResets    PasswordResetCode[]

  @@index([workspaceId])
  @@index([branchId])
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("TODO") // TODO, IN_PROGRESS, DONE

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([userId])
}

model Customer {
  id          String    @id @default(cuid())
  fullName    String
  phone       String
  email       String?
  dateOfBirth DateTime?
  gender      String?
  address     String?
  notes       String?
  tags        String[]  @default([])

  primaryMemberId String?
  primaryMember   Customer? @relation("FamilyLink", fields: [primaryMemberId], references: [id], onDelete: Cascade)
  familyMembers   Customer[] @relation("FamilyLink")
  relationType    String?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  prescriptions Prescription[]
  orders Order[]
  appointments Appointment[]
  ledger      Ledger?
  visits      Visit[]
  
  loyaltyPoints  Int       @default(0)
  membershipTier String    @default("Bronze")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, phone])
  @@index([workspaceId, fullName])
}

model Prescription {
  id                String   @id @default(cuid())
  rightSphere       Float?
  rightCylinder     Float?
  rightAxis         Int?
  rightAdd          Float?
  leftSphere        Float?
  leftCylinder      Float?
  leftAxis          Int?
  leftAdd           Float?
  pupillaryDistance Float?
  doctorName        String?
  prescriptionDate  DateTime @default(now())
  notes             String?

  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  orders      Order[]

  visitId     String?
  visit       Visit?    @relation(fields: [visitId], references: [id], onDelete: SetNull)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([customerId])
  @@index([visitId])
  @@index([workspaceId, customerId])
}

model Order {
  id                   String        @id @default(cuid())
  orderNumber          String        @unique
  frameName            String?
  frameBrand           String?
  frameModel           String?
  lensType             String?
  lensCoating          String?
  quantity             Int           @default(1)
  subtotal             Float         @default(0)
  discount             Float         @default(0)
  tax                  Float         @default(0)
  total                Float         @default(0)
  paidAmount           Float         @default(0)
  balanceAmount        Float         @default(0)
  status               OrderStatus   @default(PENDING)
  paymentStatus        PaymentStatus @default(UNPAID)
  expectedDeliveryDate DateTime?
  paymentDueDate       DateTime?
  warrantyExpiresAt    DateTime?
  notes                String?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  prescriptionId String?
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])

  visitId        String?
  visit          Visit?        @relation(fields: [visitId], references: [id], onDelete: SetNull)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  branchId    String?
  branch      Branch? @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([customerId])
  @@index([prescriptionId])
  @@index([visitId])
  @@index([branchId])
  @@index([workspaceId, customerId])
  @@index([workspaceId, status])
  @@index([workspaceId, paymentStatus])
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  READY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

model Appointment {
  id              String            @id @default(cuid())
  scheduledAt     DateTime
  durationMinutes Int               @default(30)
  type            String            @default("Examination") // Examination | Frame Selection | Collection | Follow-up | Walk-in
  status          AppointmentStatus @default(SCHEDULED)
  doctorName      String?
  notes           String?
  reminderSentAt  DateTime?

  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  branchId    String?
  branch      Branch? @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([customerId])
  @@index([branchId])
  @@index([workspaceId, scheduledAt])
  @@index([workspaceId, status])
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  WALK_IN
}

model WorkspaceSettings {
  id                String    @id @default(cuid())
  taxRate           Float     @default(0.0)
  taxIdNumber       String?
  clinicEmail       String?
  clinicPhone       String?
  clinicWebsite     String?
  autoBackupEnabled Boolean   @default(false)
  
  workspaceId       String    @unique
  workspace         Workspace @relation(fields: [workspaceId], references: [id])
}

model Branch {
  id            String    @id @default(cuid())
  name          String
  address       String
  phone         String?
  businessHours String?   // JSON string of { day: string, open: string, close: string }[]

  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id])

  users         User[]
  orders        Order[]
  visits        Visit[]
  appointments  Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  userName    String?  // denormalized for fast display
  action      String   // e.g. "CREATE", "UPDATE", "DELETE"
  entityType  String   // e.g. "Order", "Customer", "Appointment"
  entityId    String?  // ID of the affected entity
  details     String?  // JSON context (before/after diff)
  ipAddress   String?
  userAgent   String?
  workspaceId String
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Product {
  id          String    @id @default(cuid())
  name        String
  sku         String    @unique
  barcode     String?   @unique
  price       Float
  quantity    Int       @default(0)
  
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
}

model Expense {
  id          String   @id @default(cuid())
  description String
  category    String   // RENT, UTILITIES, SALARY, STOCK, OTHER
  amount      Float
  date        DateTime @default(now())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

model Supplier {
  id            String          @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  workspaceId   String
  workspace     Workspace       @relation(fields: [workspaceId], references: [id])
  purchases     PurchaseOrder[]
}

model PurchaseOrder {
  id          String    @id @default(cuid())
  supplierId  String
  supplier    Supplier  @relation(fields: [supplierId], references: [id])
  totalAmount Float
  status      String    // PENDING, COMPLETED, CANCELLED
  items       String?   // JSON list of purchased items (frames/lenses)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  expectedDeliveryDate DateTime?
  createdAt   DateTime  @default(now())
}

model Ledger {
  id             String              @id @default(cuid())
  customerId     String              @unique
  customer       Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  currentBalance Float               @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  transactions   LedgerTransaction[]
  
  workspaceId    String
  workspace      Workspace           @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([customerId])
}

model LedgerTransaction {
  id          String                 @id @default(cuid())
  ledgerId    String
  ledger      Ledger                 @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  type        LedgerTransactionType
  referenceId String?                // Link to OrderId or other reference
  amount      Float
  debit       Float                  @default(0)
  credit      Float                  @default(0)
  balance     Float                  // Running balance after this transaction
  notes       String?

  visitId     String?
  visit       Visit?                 @relation(fields: [visitId], references: [id], onDelete: SetNull)

  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([ledgerId])
  @@index([visitId])
}

enum LedgerTransactionType {
  INVOICE_CREATED
  ADVANCE_PAYMENT
  FULL_PAYMENT
  PARTIAL_PAYMENT
  REFUND
  ADJUSTMENT
  DISCOUNT
  RETURN
  EXCHANGE
  OPENING_BALANCE
}

model StaffSchedule {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  date        DateTime
  type        String   // SHIFT, LEAVE, HOLIDAY
  notes       String?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([userId])
  @@index([workspaceId, date])
}

model CalendarReminder {
  id          String   @id @default(cuid())
  title       String
  notes       String?
  date        DateTime
  time        String?  // HH:MM
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, date])
}

model Visit {
  id             String             @id @default(cuid())
  customerId     String
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  date           DateTime           @default(now())
  type           String             // e.g. "Full Exam", "Fitting", "Follow-up", "Quick Buy"
  doctorName     String?
  notes          String?

  prescriptions  Prescription[]
  orders         Order[]
  transactions   LedgerTransaction[]

  workspaceId    String
  workspace      Workspace          @relation(fields: [workspaceId], references: [id])

  branchId       String?
  branch         Branch?            @relation(fields: [branchId], references: [id])

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([workspaceId])
  @@index([customerId])
  @@index([branchId])
  @@index([workspaceId, date])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  userAgent  String?
  ipAddress  String?
  deviceName String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model VerificationCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
